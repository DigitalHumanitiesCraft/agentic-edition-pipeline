        "xmlns": {
          "type": "string",
          "required": true,
          "values": ["http://www.tei-c.org/ns/1.0"]
        },
        "xml:id": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "teiHeader": {
      "allowedChildren": ["fileDesc", "profileDesc", "encodingDesc", "revisionDesc"],
      "allowedParents": ["TEI"],
      "attributes": {},
      "selfClosing": false
    },
    "fileDesc": {
      "allowedChildren": ["titleStmt", "publicationStmt", "sourceDesc"],
      "allowedParents": ["teiHeader"],
      "attributes": {},
      "selfClosing": false
    },
    "titleStmt": {
      "allowedChildren": ["title", "author", "editor"],
      "allowedParents": ["fileDesc"],
      "attributes": {},
      "selfClosing": false
