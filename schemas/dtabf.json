    "title": {
      "allowedChildren": ["#text", "hi", "foreign", "name", "persName", "placeName", "date"],
      "allowedParents": ["titleStmt", "bibl", "msDesc"],
      "attributes": {
        "type": {
          "type": "string",
          "required": false,
          "values": ["main", "sub", "alt"]
        },
        "level": {
          "type": "string",
          "required": false,
          "values": ["a", "m", "s", "j", "u"]
        }
      },
      "selfClosing": false
    },
    "author": {
      "allowedChildren": ["#text", "persName", "name"],
      "allowedParents": ["titleStmt", "bibl"],
      "attributes": {
        "ref": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "editor": {
      "allowedChildren": ["#text", "persName", "name"],
      "allowedParents": ["titleStmt"],
      "attributes": {
        "role": {
          "type": "string",
          "required": false
        },
        "ref": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "publicationStmt": {
      "allowedChildren": ["publisher", "date", "availability"],
      "allowedParents": ["fileDesc"],
      "attributes": {},
      "selfClosing": false
    },
    "publisher": {
      "allowedChildren": ["#text", "orgName", "name", "ref"],
      "allowedParents": ["publicationStmt"],
      "attributes": {},
      "selfClosing": false
