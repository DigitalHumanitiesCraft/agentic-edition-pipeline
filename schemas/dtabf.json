{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTA-Basisformat TEI Profile",
  "description": "Structural constraints for TEI elements following the Deutsches Textarchiv Base Format. Defines allowed parent-child relationships, attributes, and self-closing behaviour for each element.",
  "version": "1.0.0",
  "namespace": "http://www.tei-c.org/ns/1.0",
  "elements": {
    "TEI": {
      "allowedChildren": ["teiHeader", "text"],
      "allowedParents": [],
