    "date": {
      "allowedChildren": ["#text"],
      "allowedParents": ["publicationStmt", "origin", "bibl", "titleStmt", "title", "p", "div", "note", "cell", "item", "head"],
      "attributes": {
        "when": {
          "type": "string",
          "required": false
        },
        "notBefore": {
          "type": "string",
          "required": false
        },
        "notAfter": {
          "type": "string",
          "required": false
        },
        "type": {
          "type": "string",
          "required": false
        },
        "confidence": {
          "type": "string",
          "required": false,
          "values": ["high", "medium", "low"]
        },
        "resp": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "availability": {
      "allowedChildren": ["licence", "p"],
      "allowedParents": ["publicationStmt"],
      "attributes": {
        "status": {
          "type": "string",
          "required": false,
          "values": ["free", "restricted", "unknown"]
