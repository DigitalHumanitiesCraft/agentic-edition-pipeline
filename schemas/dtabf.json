    "physDesc": {
      "allowedChildren": ["p"],
      "allowedParents": ["msDesc"],
      "attributes": {},
      "selfClosing": false
    },
    "history": {
      "allowedChildren": ["origin"],
      "allowedParents": ["msDesc"],
      "attributes": {},
      "selfClosing": false
    },
    "origin": {
      "allowedChildren": ["origDate", "origPlace", "p"],
      "allowedParents": ["history"],
      "attributes": {},
      "selfClosing": false
    },
    "origDate": {
      "allowedChildren": ["#text"],
      "allowedParents": ["origin"],
      "attributes": {
        "when": {
          "type": "string",
          "required": false
        },
        "notBefore": {
          "type": "string",
          "required": false
        },
        "notAfter": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "origPlace": {
      "allowedChildren": ["#text", "placeName"],
      "allowedParents": ["origin"],
      "attributes": {
        "ref": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "profileDesc": {
      "allowedChildren": ["langUsage", "textClass"],
      "allowedParents": ["teiHeader"],
      "attributes": {},
      "selfClosing": false
    },
    "langUsage": {
      "allowedChildren": ["language"],
      "allowedParents": ["profileDesc"],
      "attributes": {},
      "selfClosing": false
    },
    "language": {
      "allowedChildren": ["#text"],
      "allowedParents": ["langUsage"],
      "attributes": {
        "ident": {
          "type": "string",
          "required": true
        },
        "usage": {
          "type": "string",
          "required": false
        }
      },
      "selfClosing": false
    },
    "textClass": {
      "allowedChildren": ["keywords"],
      "allowedParents": ["profileDesc"],
      "attributes": {},
      "selfClosing": false
