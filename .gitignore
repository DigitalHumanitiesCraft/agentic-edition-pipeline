# Environment
.env
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Data (user-provided and generated)
#
# Note on negations: a pattern like `results/**` also matches everything inside
# subdirectories, and `!results/tei/` re-includes only the directory itself,
# not its contents. To version files below an ignored tree you need a
# recursive negation for the contents, e.g.:
#   !data/sources/text/*.json    # check in a small transcription fixture set
#   !results/tei/**              # check in TEI candidates for project gates
#   !docs/data/**                # check in the generated frontend data
# Keep re-obtainable data (remote facsimiles, bulk scans) ignored.
data/processed/**
!data/processed/.gitkeep
data/sources/**
!data/sources/manifest.json
!data/sources/pdf/
!data/sources/images/
!data/sources/text/
!data/sources/*/.gitkeep

# Results (generated)
results/**
!results/tei/
!results/tei/**
!results/reports/
!results/*/.gitkeep

# Generated frontend data
docs/data/**
!docs/data/.gitkeep

# Isolated output of the synthetic offline quickstart
.aep-quickstart/

# Facsimiles copied into docs/ by step 6 are publication assets, so
# docs/images/ is deliberately not ignored.

# IDE and OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
*.bak
*.swp
