# === API Keys ===
# At least one provider is required for transcription (step 3).
# Validation (step 4) can run without an API key. TEI generation (step 5) is deterministic.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# === Models per pipeline step ===
# Provider: gemini | openai | anthropic | ollama
# Leave VALIDATION_PROVIDER empty for deterministic-only validation.

TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-2.5-flash

VALIDATION_PROVIDER=
VALIDATION_MODEL=

# === Processing ===
BATCH_DELAY=2.0
CHUNK_SIZE=20
IMAGE_DPI=150
FETCH_DELAY_SECONDS=0.5
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_SECONDS=1.0
