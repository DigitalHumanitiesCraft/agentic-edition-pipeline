# === API Keys ===
# At least one provider is required for transcription (step 3).
# Validation (step 4) and annotation (step 5) work without API keys in deterministic mode.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# === Models per pipeline step ===
# Provider: gemini | openai | anthropic | ollama
# Leave VALIDATION_PROVIDER and ANNOTATION_PROVIDER empty for deterministic-only mode.

TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-2.5-flash

VALIDATION_PROVIDER=
VALIDATION_MODEL=

ANNOTATION_PROVIDER=
ANNOTATION_MODEL=

# === Processing ===
BATCH_DELAY=2.0
CHUNK_SIZE=20
IMAGE_DPI=150
